# Copy to .env (scripts/init.sh does this and fills the "auto" values). Dummy values below are for local dev only.

POSTGRES_PASSWORD=               # auto
BACKEND_PORT=3000
BACKEND_JWT_SECRET=              # auto; signs customer/agent session tokens for the backend REST API
ADMIN_API_TOKEN=                 # auto; protects POST /api/admin/reload-config
CUSTOMER_AUTH_MODE=anonymous     # anonymous | external_jwt
# only used if CUSTOMER_AUTH_MODE=external_jwt (dummy placeholder, not a real key)
EXTERNAL_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nDUMMY-REPLACE-ME\n-----END PUBLIC KEY-----"

# --- LiveKit ---------------------------------------------------------------------------------
# LIVEKIT_URL is set by docker-compose (http://livekit:7880) for the bundled server; set it here only for
# LiveKit Cloud / an external server (https://<project>.livekit.cloud).
LIVEKIT_PUBLIC_URL=ws://localhost:8080/livekit   # what browsers connect to (wss://<project>.livekit.cloud for Cloud)
LIVEKIT_API_KEY=                 # auto
LIVEKIT_API_SECRET=              # auto
# Let participants publish microphone / camera tracks. Text chat works with both off.
ENABLE_VOICE=false
ENABLE_VIDEO=false

# --- AI voice assistant (voice-agent/ worker; docker compose --profile voice up -d --build) --------------------
# The pipeline (VAD, noise suppression, turn detection, STT, LLM, TTS) is chosen in the Agent console -> Voice settings.
# Put the API keys for the providers you want to use here; Voice settings shows which ones are still missing.
INTERNAL_API_TOKEN=              # auto; shared secret between the backend and the voice worker
VOICE_AGENT_NAME=support-voice
VOICE_IDLE_PROCESSES=2           # pre-warmed call processes; set to your expected number of simultaneous calls
# DEEPGRAM_API_KEY=
# ELEVENLABS_API_KEY=
# CARTESIA_API_KEY=
# NEUPHONIC_API_KEY=
# MURF_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=                      # Gemini TTS
# GOOGLE_APPLICATION_CREDENTIALS=      # Google Cloud TTS: the service-account JSON itself, or a file path
# AZURE_SPEECH_API_KEY=
# AZURE_SPEECH_REGION=                 # or AZURE_SPEECH_ENDPOINT
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AIC_SDK_LICENSE=                     # ai-coustics VAD / noise suppression
# CUE_SERVER_URL=http://localhost:8090 # Pype cue-v1 turn detector (llama.cpp server)

# OpenAI-compatible endpoint, e.g. a LiteLLM proxy (https://host or https://host/v1)
LLM_BASE_URL=https://litellm.example.com
LLM_API_KEY=sk-dummy-replace-with-your-litellm-key
LLM_MODEL=gpt-4.1-mini

AI_HISTORY_MESSAGES=30
AI_STREAM_INTERVAL_MS=60
TOOLS_CONFIG_PATH=./config/tools.yaml
PROMPTS_DIR=./config/prompts
COMPANY_NAME=Acme Support

# Used when the host web page does not send the customer's details
DEFAULT_CUSTOMER_NAME=Test User
DEFAULT_CUSTOMER_EMAIL=testuser@test.com
DEFAULT_CUSTOMER_PHONE=+9876543210

# --- Email (escalate_via_email tool). Default: local fake SMTP (Mailpit), inbox http://localhost:8025 ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=support@chat.local
SUPPORT_EMAIL_TO=support@example.com

WEBHOOK_SIGNING_SECRET=          # auto; HMAC secret for outgoing webhook calls
TICKETS_API_TOKEN=dummy-tickets-token
